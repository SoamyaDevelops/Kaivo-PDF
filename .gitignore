# ── Dependencies ──────────────────────────────────────────────────────
node_modules/
jspm_packages/
web_modules/

# ── Build Outputs & Distribution ──────────────────────────────────────
dist/
build/
out/
bin/
*.exe
*.dmg
*.AppImage
*.deb
*.rpm
*.snap

# ── Log Files ─────────────────────────────────────────────────────────
*.log
app-debug.log
console.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── IDEs, Editors & Workspaces ────────────────────────────────────────
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# ── OS Generated Files ────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ── Local Credentials & Configs ───────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.direnv/
